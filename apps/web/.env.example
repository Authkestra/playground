# Base URL of the playground API.
#
# Local development (the default when unset):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Deployed: point this at the API and make sure the API's ALLOWED_ORIGINS names
# this frontend's origin in return. CORS here is *credentialed* (the demo
# session rides in an HttpOnly cookie), so a mismatch does not raise a visible
# error — the browser silently drops the cookie and every request looks like a
# brand-new visitor.
NEXT_PUBLIC_API_BASE_URL=https://authkestra-playground-api.fly.dev
